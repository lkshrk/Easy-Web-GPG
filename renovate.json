{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>lkshrk/gh-ops//renovate/presets/app-library.json5",
    "helpers:pinGitHubActionDigests",
    "group:monorepos",
    "group:linters"
  ],
  "ignorePresets": [":ignoreModulesAndTests"],
  "schedule": ["before 7am every weekday"],
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tailwind CLI release pinned by version and per-arch SHA256 in the Dockerfile",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG TAILWIND_VERSION=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tailwindlabs/tailwindcss"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go dependencies (major)"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["tests/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Test dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["tests/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "Test dependencies (major)"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Docker base images"
    },
    {
      "description": "Release assets are pinned by checksum in the Dockerfile; the PR must update TAILWIND_SHA256_* too",
      "matchDepNames": ["tailwindlabs/tailwindcss"],
      "addLabels": ["checksum-update"],
      "automerge": false
    },
    {
      "description": "Base image updates ship in the published image, so commit them as fixes to trigger a release",
      "matchFileNames": ["**/Dockerfile"],
      "semanticCommitType": "fix"
    },
    {
      "description": "The test image must match the @playwright/test version",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright"
    }
  ]
}
